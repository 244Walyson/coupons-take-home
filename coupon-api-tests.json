{
  "info": {
    "name": "API Cupons - Testes Completos",
    "description": "Coleção completa para testar a API de cupons com todas as regras de negócio",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "coupon_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Coupon - Cenários de Sucesso",
      "item": [
        {
          "name": "Criar cupom válido básico",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Resposta contém todos os campos obrigatórios\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response).to.have.property('id');",
                  "    pm.expect(response).to.have.property('code');",
                  "    pm.expect(response).to.have.property('description');",
                  "    pm.expect(response).to.have.property('discountValue');",
                  "    pm.expect(response).to.have.property('expirationDate');",
                  "    pm.expect(response).to.have.property('published');",
                  "    pm.expect(response).to.have.property('redeemed');",
                  "    pm.expect(response).to.have.property('status');",
                  "});",
                  "",
                  "pm.test(\"Código do cupom tem 6 caracteres\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.code).to.have.lengthOf(6);",
                  "});",
                  "",
                  "pm.test(\"Status inicial é ACTIVE\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.status).to.eql('ACTIVE');",
                  "});",
                  "",
                  "pm.test(\"Redeemed é false por padrão\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.redeemed).to.be.false;",
                  "});",
                  "",
                  "// Salvar ID para testes posteriores",
                  "pm.collectionVariables.set(\"coupon_id\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"TESTE1\",\n  \"description\": \"Cupom de teste válido\",\n  \"discountValue\": 0.5,\n  \"expirationDate\": \"2026-12-31T23:59:59.999Z\",\n  \"published\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/coupon",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "coupon"
              ]
            }
          }
        },
        {
          "name": "Criar cupom com caracteres especiais no código",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
