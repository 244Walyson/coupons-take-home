                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Código teve caracteres especiais removidos\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.code).to.match(/^[A-Z0-9]{6}$/);",
                  "});",
                  "",
                  "pm.test(\"Código tem exatamente 6 caracteres\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.code).to.have.lengthOf(6);",
                  "});"
                ]
              }
            }
          ],
